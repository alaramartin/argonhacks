# Copy to .env (gitignored) and fill in. Read by agents/env.py.
GEMINI_API_KEY=

# Optional overrides
# PRICING_AGENT=antigravity-preview-09-2026
# POL_EVENTS=out/events.jsonl

# Part 2: Mock Mutual portal.
# Hosted on Vercel (portal-vercel/), stays up with the laptop closed, no tunnel. Set all four; the two tokens must
# match the PORTAL_TOKEN and POLICYHOLDER_TOKEN env vars on the Vercel project (ask A for the values).
# PORTAL_PUBLIC_URL=https://mock-mutual-portal.vercel.app     # where the sandboxed claim agent goes
# PORTAL_REMOTE_URL=https://mock-mutual-portal.vercel.app     # local server.js forwards to it and copies its events
# PORTAL_TOKEN=                                                # the agent's token (injected by the Credentials API)
# POLICYHOLDER_TOKEN=                                          # only on the demo laptop: review, photos, submit
#
# Or the original local portal through a public tunnel (cloudflared tunnel --url http://localhost:8090):
# PORTAL_PUBLIC_URL=https://<random>.trycloudflare.com
