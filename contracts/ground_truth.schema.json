{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ground_truth.schema.json",
  "title": "ground_truth.json",
  "description": "Hand count of every item in the demo room. Written once by a person, never by an agent.",
  "type": "object",
  "required": ["items"],
  "properties": {
    "room": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string", "description": "what it is, e.g. \"floor lamp\"" },
          "aliases": { "type": "array", "items": { "type": "string" }, "description": "other words a model might use, e.g. [\"standing lamp\", \"lamp\"]" },
          "location": { "type": "string", "description": "rough location, e.g. \"left of sofa\"" }
        }
      }
    }
  }
}
